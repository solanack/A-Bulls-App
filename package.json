{
  "name": "a-bulls-app-experience-build",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:experience-vendor": "node scripts/build-experience-vendor.mjs",
    "build:worker-baseline": "node scripts/reconstruct-worker-8.2.0.mjs",
    "validate:release-candidate": "npm run build:experience-vendor && npm run build:worker-baseline && node scripts/validate-release-candidate.mjs",
    "test:worker-compat": "node --test workers/worker-vnext-entry.test.mjs",
    "test:universe-v2": "node --test workers/intelligence-universe-v2.test.mjs",
    "test:intelligence": "node --test workers/*.test.mjs",
    "validate:production-config": "node scripts/verify-production-config.mjs"
  },
  "dependencies": {
    "mediabunny": "1.55.2",
    "three": "0.185.0"
  }
}
